    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/Broadcast Server.dll",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "start"
            ]
        },
        {
            "name": "C#: Client",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/Broadcast Server.dll",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "connect"
            ]
        }
    ]
}
